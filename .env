PROJECT_NAME="Credit Analysis System"
API_V1_STR="/api/v1"
BACKEND_CORS_ORIGINS=["http://localhost", "http://127.0.0.1", "http://localhost:8501", "http://127.0.0.1:8501"]

# LLM provider configuration (default to mock)
LLM_PROVIDER="grok"  # 可选：mock/http/openai/openrouter/deepseek/deepsee/grok/gemini/qwen/kimi
LLM_API_BASE="https://api.x.ai"
LLM_API_KEY=""
LLM_TIMEOUT_SECONDS=20
LLM_TASK_MODELS={"INDUSTRY_ANALYSIS":"general-32k","FINANCIAL_EXPLAIN":"general-16k","RISK_SUMMARY":"risk-analyst","COMPANY_PROFILE_ENRICH":"general-16k","OCR_STRUCTURED_PARSE":"general-32k"}

# Search / web enrichment configuration
SEARCH_API_BASE_URL="https://api.tavily.com"
SEARCH_API_KEY=""
SEARCH_TIMEOUT_SECONDS=10

# Streamlit UI calls this endpoint
API_BASE_URL="http://localhost:8000/api/v1"
